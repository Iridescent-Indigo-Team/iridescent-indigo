# Auto detect text files and perform LF normalization
* text=auto

# Code files
*.rb text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.tmj text eol=lf
*.tsj text eol=lf
*.tj text eol=lf
*.tiled-project text eol=lf

# Audio files
*.ogg binary
*.m4a binary
*.wav binary
*.mp3 binary

# Graphic files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

# Video files
*.mp4 binary
*.webm binary

# Font files
*.ttf binary
*.woff binary
*.woff2 binary
*.otf binary

# Executables and binaries
*.exe binary
*.app binary
*.dll binary