{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ribbons.txt",
  "type": "object",
  "properties": {
    "$schema": {"type": "string"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "suffix": {"type": "string"},
          "bom": {"type": "boolean"},
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^(?![0-9])\\w+$",
                  "description": "An id: letters, digits and underscores, not starting with a digit."
                },
                "real_name": {"type": "string", "pattern": "^[^#]*$", "description": "Text."},
                "icon_position": {"type": "integer", "minimum": 0, "description": "PBS key: IconPosition"},
                "real_description": {
                  "type": "string",
                  "pattern": "^[^#]*$",
                  "description": "Text (the rest of the line, written as is)."
                },
                "flags": {
                  "type": "array",
                  "items": {"type": "string", "pattern": "^[^#]*$", "description": "Text."},
                  "description": "PBS key: Flags"
                }
              },
              "required": ["id"],
              "additionalProperties": false
            }
          }
        },
        "required": ["suffix", "entries"],
        "additionalProperties": false
      }
    }
  },
  "required": ["files"],
  "additionalProperties": false
}
