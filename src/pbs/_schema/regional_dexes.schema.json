{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "regional_dexes.txt",
  "type": "object",
  "properties": {
    "$schema": {"type": "string"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "suffix": {"type": "string"},
          "bom": {"type": "boolean"},
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {"type": "integer", "minimum": 0},
                "families": {
                  "type": "array",
                  "description": "Lines of species ids from pokemon.txt, in Dex order.",
                  "items": {
                    "type": "array",
                    "items": {"type": "string"}
                  }
                }
              },
              "required": ["id", "families"],
              "additionalProperties": false
            }
          }
        },
        "required": ["suffix", "entries"],
        "additionalProperties": false
      }
    }
  },
  "required": ["files"],
  "additionalProperties": false
}
